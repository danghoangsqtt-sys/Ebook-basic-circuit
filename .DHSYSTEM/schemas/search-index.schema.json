{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated lesson search index",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lessons"],
  "properties": {
    "version": { "const": 1 },
    "lessons": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "title", "headings", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^day(0[1-9]|[1-4][0-9]|5[0-6])$" },
          "url": { "type": "string", "pattern": "^week[1-8]/day[0-9]{2}\\.html$" },
          "title": { "type": "string", "minLength": 1 },
          "headings": { "type": "array", "items": { "type": "string" } },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
